# Downloaded datasets -- 1.5 GB, re-fetchable from the Flatiron Institute URLs
# recorded in notes/understanding_data.md. Never commit these.
data/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Environments
.env
*.egg-info/

# Per-machine tool permissions, not shared
.claude/settings.local.json

# macOS
.DS_Store

# TensorBoard event files. sbi writes one per training run whether asked to or not.
# 269 of them appeared during the sweep. They hold only loss curves and regenerate.
sbi-logs/

# Saved posteriors and per-epoch summaries that ltu-ili writes to out_dir. Nothing
# reads them; every number we quote lives in ili_kaai/results/*.json.
ili_kaai/results/runs/

# Runtime output directory. The emitted ltu-ili configs default to ./ili_out,
# so running one creates this. Nothing in it is a result.
ili_out/
